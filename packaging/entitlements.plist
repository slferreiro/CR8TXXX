<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the Developer ID build (hardened runtime). -->
<plist version="1.0">
<dict>
	<!-- PyInstaller's Python loads its extension modules from inside the app; this keeps
	     them loading if one ends up signed differently. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
